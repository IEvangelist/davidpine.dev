---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import siteConfig from '~/site.config'
import LightDarkAutoButton from '~/components/LightDarkAutoButton.astro'
import Search from '~/components/Search.astro'
import SelectTheme from '~/components/SelectTheme.astro'
import NavLink from '~/components/NavLink.astro'
import avatarImage from '~/content/avatar.png'
import GitHubMark from '~/icons/github.svg'

const lightDarkAutoTheme = siteConfig.themes.mode === 'light-dark-auto'
const selectTheme =
  siteConfig.themes.mode === 'select' && siteConfig.themes.include.length > 1

const primaryNames = new Set(['Blog', 'Projects', 'About', 'Speaking'])
const exploreNames = new Set(['Media', 'Slides', 'Conclusions', 'Pictures'])
const primaryLinks = siteConfig.navLinks.filter((link) => primaryNames.has(link.name))
const exploreLinks = siteConfig.navLinks.filter((link) => exploreNames.has(link.name))
const githubUrl = siteConfig.socialLinks.github
const mobileLinks = siteConfig.navLinks.filter((link) => link.name !== 'Home')
---

<site-header>
  <header class="site-header">
    <a class="brand" href="/" aria-label="David Pine, home">
      <Image class="brand-avatar" src={avatarImage} alt="" width={42} height={42} />
      <span class="brand-name">David Pine</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          primaryLinks.map((link) => (
            <li>
              <NavLink link={link} />
            </li>
          ))
        }
        <li>
          <details class="explore-menu">
            <summary>
              Explore
              <Icon name="ph:caret-down" aria-hidden="true" />
            </summary>
            <div class="explore-panel">
              {exploreLinks.map((link) => <NavLink link={link} />)}
            </div>
          </details>
        </li>
      </ul>
    </nav>

    <div class="header-tools">
      <Search trailingSlashes={siteConfig.trailingSlashes} />
      {lightDarkAutoTheme && <LightDarkAutoButton />}
      {selectTheme && <SelectTheme />}
      {
        githubUrl && (
          <a
            class="icon-control github-control"
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <GitHubMark aria-hidden="true" />
          </a>
        )
      }
      <button
        class="icon-control mobile-menu-trigger"
        type="button"
        aria-label="Open navigation"
        aria-haspopup="dialog"
        data-open-mobile-menu
      >
        <Icon name="ph:list" aria-hidden="true" />
      </button>
    </div>
  </header>

  <dialog class="mobile-menu" aria-labelledby="mobile-menu-title" data-mobile-menu>
    <div class="mobile-menu-frame">
      <div class="mobile-menu-header">
        <p id="mobile-menu-title" class="font-display">Navigate</p>
        <button
          class="icon-control"
          type="button"
          aria-label="Close navigation"
          data-close-mobile-menu
        >
          <Icon name="ph:x" aria-hidden="true" />
        </button>
      </div>
      <nav aria-label="Mobile navigation">
        <ul>
          {
            mobileLinks.map((link) => (
              <li>
                <NavLink link={link} />
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="mobile-menu-note">
        Writing, software, speaking, and the work behind them.
      </p>
    </div>
  </dialog>
</site-header>

<script>
  class SiteHeader extends HTMLElement {
    #controller = new AbortController()
    #dialog = this.querySelector<HTMLDialogElement>('[data-mobile-menu]')
    #openButton = this.querySelector<HTMLButtonElement>('[data-open-mobile-menu]')
    #closeButton = this.querySelector<HTMLButtonElement>('[data-close-mobile-menu]')

    connectedCallback() {
      const options = { signal: this.#controller.signal }
      this.#openButton?.addEventListener('click', this.#open, options)
      this.#closeButton?.addEventListener('click', this.#close, options)
      this.#dialog?.addEventListener('click', this.#onDialogClick, options)
      this.#dialog?.addEventListener('close', this.#onClose, options)

      this.querySelectorAll<HTMLAnchorElement>('.mobile-menu a').forEach((link) => {
        link.addEventListener('click', this.#close, options)
      })
    }

    disconnectedCallback() {
      this.#controller.abort()
    }

    #open = () => {
      this.#dialog?.showModal()
      document.body.classList.add('dialog-open')
    }

    #close = () => {
      this.#dialog?.close()
    }

    #onClose = () => {
      document.body.classList.remove('dialog-open')
      this.#openButton?.focus()
    }

    #onDialogClick = (event: MouseEvent) => {
      if (event.target === this.#dialog) {
        this.#close()
      }
    }
  }

  if (!customElements.get('site-header')) {
    customElements.define('site-header', SiteHeader)
  }
</script>

<style>
  site-header {
    position: sticky;
    z-index: var(--z-sticky);
    top: 0;
    display: block;
    padding-top: 0.75rem;
  }

  .site-header {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) auto minmax(12rem, 1fr);
    align-items: center;
    min-height: 4.5rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-control);
    background: color-mix(in oklab, var(--theme-background) 82%, transparent);
    box-shadow: 0 0.75rem 2.5rem var(--theme-shadow);
    backdrop-filter: blur(18px) saturate(130%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: max-content;
    color: var(--theme-foreground);
    text-decoration: none;
  }

  .brand-avatar {
    width: 2.65rem;
    height: 2.65rem;
    border: 2px solid var(--theme-accent);
    border-radius: 50%;
    object-fit: cover;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .desktop-nav > ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav li {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .explore-menu {
    position: relative;
  }

  .explore-menu summary {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--theme-text-muted);
    font-size: 0.94rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .explore-menu summary::-webkit-details-marker {
    display: none;
  }

  .explore-menu summary svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .explore-menu[open] summary svg {
    transform: rotate(180deg);
  }

  .explore-panel {
    position: absolute;
    top: calc(100% + 1.2rem);
    left: 50%;
    display: grid;
    min-width: 13rem;
    padding: 0.65rem;
    border: 1px solid var(--theme-border);
    border-radius: 1rem;
    background: var(--theme-background);
    box-shadow: 0 1.25rem 4rem var(--theme-shadow);
    transform: translateX(-50%);
  }

  .explore-panel :global(.nav-link) {
    padding: 0.7rem 0.8rem;
    border-radius: 0.65rem;
  }

  .explore-panel :global(.nav-link:hover),
  .explore-panel :global(.nav-link[aria-current='page']) {
    background: var(--theme-accent-soft);
  }

  .header-tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
  }

  :global(.icon-control) {
    display: inline-grid;
    width: 2.65rem;
    height: 2.65rem;
    min-height: 0;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: var(--theme-foreground);
    background: transparent;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      background-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }

  :global(.icon-control:hover) {
    color: var(--theme-on-accent);
    background: var(--theme-accent);
  }

  :global(.icon-control:active) {
    transform: scale(0.94);
  }

  :global(.icon-control svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .mobile-menu-trigger {
    display: none;
  }

  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--theme-foreground);
    background: var(--theme-background);
  }

  .mobile-menu::backdrop {
    background: color-mix(in oklab, var(--theme-background) 55%, transparent);
    backdrop-filter: blur(10px);
  }

  .mobile-menu-frame {
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    padding: 1rem;
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--theme-border);
  }

  .mobile-menu-header p {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 600;
  }

  .mobile-menu ul {
    margin: 0;
    padding: 1.25rem 0 0;
    list-style: none;
  }

  .mobile-menu li {
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--theme-border);
    list-style: none;
  }

  .mobile-menu :global(.nav-link) {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 10vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .mobile-menu :global(.nav-link)::after {
    content: '↗';
    color: var(--theme-text-muted);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .mobile-menu-note {
    max-width: 26rem;
    margin: auto 0 0;
    padding-top: 2rem;
    color: var(--theme-text-muted);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--theme-background);
    }
  }

  @media (max-width: 63.99rem) {
    .site-header {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .github-control {
      display: none;
    }

    .mobile-menu-trigger {
      display: inline-grid;
    }
  }

  @media (max-width: 32rem) {
    .brand-name {
      display: none;
    }
  }
</style>
