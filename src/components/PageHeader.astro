---
interface Props {
  title?: string
  titlePieces?: string[]
  description?: string
}

const { title, titlePieces, description } = Astro.props
const splitPath = Astro.url.pathname
  .split('/')
  .filter(Boolean)
  .map((part) => decodeURIComponent(part))
const pieces = titlePieces ?? splitPath
const displayTitle =
  title ?? (pieces.at(-1) === 'posts' ? 'Blog' : (pieces.at(-1) ?? 'Home'))
const breadcrumbs = pieces.slice(0, -1)
---

<header class="page-header" data-reveal>
  {
    breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb">
        <a href="/">Home</a>
        {breadcrumbs.map((piece) => (
          <>
            <span aria-hidden="true">/</span>
            <span class="breadcrumb-label">{piece}</span>
          </>
        ))}
      </nav>
    )
  }
  <h1>{displayTitle}</h1>
  {description && <p>{description}</p>}
</header>

<style>
  .page-header {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(4.5rem, 11vw, 9rem);
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(
        90deg,
        var(--theme-accent),
        var(--theme-blue),
        var(--theme-magenta),
        var(--theme-border) 72%
      )
      1;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    color: var(--theme-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs-fluid);
  }

  nav a {
    color: inherit;
    text-underline-offset: 0.25rem;
  }

  .breadcrumb-label {
    text-transform: capitalize;
  }

  nav a:hover {
    color: var(--theme-accent);
  }

  h1 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h1-fluid);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.055em;
    color: var(--theme-heading1);
    text-wrap: balance;
  }

  p {
    max-width: 58ch;
    margin: 0;
    color: var(--theme-text-muted);
    font-size: var(--text-lead-fluid);
    line-height: 1.5;
    text-wrap: pretty;
  }
</style>
