---
import { Icon } from 'astro-icon/components'
---

<button hidden type="button" aria-label="Scroll to top" class="scroll-up" data-magnetic>
  <Icon name="ph:arrow-up" aria-hidden="true" />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('button.scroll-up')
  const sentinel = document.querySelector<HTMLElement>('[data-scroll-top-sentinel]')

  if (button && sentinel) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    button.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      })
    })

    const setVisible = (visible: boolean) => {
      if (visible) {
        button.hidden = false
        requestAnimationFrame(() => button.classList.add('is-visible'))
      } else {
        button.classList.remove('is-visible')
      }
    }

    button.addEventListener('transitionend', (event) => {
      if (event.propertyName === 'opacity' && !button.classList.contains('is-visible')) {
        button.hidden = true
      }
    })

    new IntersectionObserver(([entry]) => setVisible(!entry.isIntersecting), {
      threshold: 0,
    }).observe(sentinel)
  }
</script>

<style>
  .scroll-up {
    position: fixed;
    z-index: var(--z-overlay);
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    display: grid;
    width: 3.1rem;
    height: 3.1rem;
    min-height: 0;
    padding: 0;
    place-items: center;
    border: 1px solid var(--theme-accent);
    border-radius: 50%;
    color: var(--theme-on-accent);
    background: var(--theme-accent);
    box-shadow: 0 0.8rem 2.4rem var(--theme-shadow);
    opacity: 0;
    transform: translateY(0.75rem) scale(0.92);
    transition:
      opacity var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo),
      color var(--duration-fast) var(--ease-out-expo),
      background-color var(--duration-fast) var(--ease-out-expo);
  }

  .scroll-up.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .scroll-up:hover {
    color: var(--theme-surface);
    background: var(--theme-foreground);
  }

  .scroll-up svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-up {
      transform: none;
    }
  }
</style>
