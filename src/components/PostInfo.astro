---
import { dateString, SeriesGroup } from '~/utils'
import { render, type CollectionEntry } from 'astro:content'
import type { Collation } from '~/types'

interface Props {
  post: CollectionEntry<'posts'>
  class?: string
}

const { post, class: className } = Astro.props
const { remarkPluginFrontmatter } = await render(post)
const { minutesRead } = remarkPluginFrontmatter
const seriesFrontmatter = post.data.series
let series: Collation<'posts'> | undefined
let seriesPostNumber: number | undefined
let seriesTotal: number | undefined

if (seriesFrontmatter) {
  const seriesGroup = await SeriesGroup.build()
  series = seriesGroup.match(seriesFrontmatter)
  if (!series) {
    throw new Error(`Series "${seriesFrontmatter}" not found`)
  }
  seriesPostNumber = series.entries.findIndex((item) => item.id === post.id) + 1
  seriesTotal = series.entries.length
}
---

<div class:list={[className, 'post-info']}>
  {
    series && seriesPostNumber && seriesTotal && (
      <a class="series-link" href={series.url}>
        {series.title}
        <span>
          {seriesPostNumber} / {seriesTotal}
        </span>
      </a>
    )
  }
  <div class="post-facts">
    <time datetime={post.data.published.toISOString()}
      >{dateString(post.data.published)}</time
    >
    {post.data.author && <span>{post.data.author}</span>}
    {minutesRead && <span>{minutesRead}</span>}
  </div>
</div>

<style>
  .post-info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
    color: var(--theme-text-muted);
    font-size: var(--text-sm-fluid);
  }

  .series-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--theme-foreground);
    font-weight: 650;
    text-decoration-color: var(--theme-border-strong);
    text-underline-offset: 0.25rem;
  }

  .series-link:hover {
    color: var(--theme-accent);
  }

  .series-link span {
    color: var(--theme-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs-fluid);
  }

  .post-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs-fluid);
  }

  .post-facts > * + *::before {
    margin-right: 0.5rem;
    color: var(--theme-border-strong);
    content: '/';
  }
</style>
