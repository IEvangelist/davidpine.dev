---
import { Icon } from 'astro-icon/components'
import siteConfig from '~/site.config'
import { resolveThemeColorStyles } from '~/utils'

function kebabToTitleCase(value: string): string {
  return value
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')
}

const resolvedThemes = await resolveThemeColorStyles(
  siteConfig.themes.include,
  siteConfig.themes.overrides,
)
const themeOptions = siteConfig.themes.include.map((theme) => {
  const styles = resolvedThemes[theme]
  return {
    id: theme,
    name: kebabToTitleCase(theme),
    background: styles?.background ?? '#111111',
    foreground: styles?.foreground ?? '#f1f1f1',
    accent: styles?.accent ?? '#888888',
  }
})
---

<select-theme>
  <button
    class="icon-control"
    type="button"
    aria-label="Choose color theme"
    aria-haspopup="dialog"
    data-open-theme
    disabled
  >
    <Icon name="ph:palette" aria-hidden="true" />
  </button>

  <dialog class="theme-dialog" aria-labelledby="theme-dialog-title" data-theme-dialog>
    <div class="dialog-frame">
      <div class="dialog-header">
        <div>
          <p class="ui-label">{themeOptions.length} palettes</p>
          <h2 id="theme-dialog-title">Choose your theme</h2>
        </div>
        <button
          class="icon-control"
          type="button"
          aria-label="Close themes"
          data-close-theme
        >
          <Icon name="ph:x" aria-hidden="true" />
        </button>
      </div>

      <label class="theme-filter">
        <span class="sr-only">Filter themes</span>
        <Icon name="ph:magnifying-glass" aria-hidden="true" />
        <input
          type="search"
          placeholder="Filter themes"
          autocomplete="off"
          data-theme-filter
        />
      </label>

      <ul class="theme-grid" data-theme-list>
        {
          themeOptions.map((theme) => (
            <li data-theme-item data-theme-name={theme.name.toLowerCase()}>
              <button
                type="button"
                data-theme={theme.id}
                aria-pressed="false"
                style={{
                  '--preview-background': theme.background,
                  '--preview-foreground': theme.foreground,
                  '--preview-accent': theme.accent,
                }}
              >
                <span class="theme-preview" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                </span>
                <span class="theme-name">{theme.name}</span>
                <Icon class="theme-check" name="ph:check" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ul>

      <p class="theme-empty" hidden data-theme-empty>No themes match that filter.</p>
    </div>
  </dialog>
</select-theme>

<script>
  class SelectTheme extends HTMLElement {
    #controller = new AbortController()
    #dialog = this.querySelector<HTMLDialogElement>('[data-theme-dialog]')
    #dialogFrame = this.querySelector<HTMLElement>('.dialog-frame')
    #openButton = this.querySelector<HTMLButtonElement>('[data-open-theme]')
    #closeButton = this.querySelector<HTMLButtonElement>('[data-close-theme]')
    #filter = this.querySelector<HTMLInputElement>('[data-theme-filter]')
    #items = Array.from(this.querySelectorAll<HTMLElement>('[data-theme-item]'))
    #empty = this.querySelector<HTMLElement>('[data-theme-empty]')

    connectedCallback() {
      const options = { signal: this.#controller.signal }
      this.#openButton?.addEventListener('click', this.#open, options)
      this.#closeButton?.addEventListener('click', this.#close, options)
      this.#filter?.addEventListener('input', this.#filterThemes, options)
      this.#dialog?.addEventListener('click', this.#onDialogClick, options)
      this.#dialog?.addEventListener('close', this.#onClose, options)
      this.querySelectorAll<HTMLButtonElement>('button[data-theme]').forEach((button) => {
        button.addEventListener('click', this.#selectTheme, options)
      })
      if (this.#openButton) this.#openButton.disabled = false
    }

    disconnectedCallback() {
      this.#controller.abort()
    }

    #highlightCurrentTheme = () => {
      const currentTheme = document.documentElement.dataset.theme
      this.querySelectorAll<HTMLButtonElement>('button[data-theme]').forEach((button) => {
        const isCurrent = button.dataset.theme === currentTheme
        button.setAttribute('aria-pressed', String(isCurrent))
      })
    }

    #open = () => {
      this.#highlightCurrentTheme()
      this.#dialog?.showModal()
      document.body.classList.add('dialog-open')
      window.setTimeout(() => this.#filter?.focus(), 0)
    }

    #close = () => {
      this.#dialog?.close()
    }

    #onClose = () => {
      document.body.classList.remove('dialog-open')
      if (this.#filter) this.#filter.value = ''
      this.#filterThemes()
      this.#openButton?.focus()
    }

    #onDialogClick = (event: MouseEvent) => {
      if (
        event.target === this.#dialog ||
        !this.#dialogFrame?.contains(event.target as Node)
      ) {
        this.#close()
      }
    }

    #filterThemes = () => {
      const query = this.#filter?.value.trim().toLowerCase() ?? ''
      let visibleCount = 0
      this.#items.forEach((item) => {
        const visible = !query || item.dataset.themeName?.includes(query)
        item.hidden = !visible
        if (visible) visibleCount += 1
      })
      if (this.#empty) this.#empty.hidden = visibleCount > 0
    }

    #selectTheme = (event: Event) => {
      const button = event.currentTarget as HTMLButtonElement
      const theme = button.dataset.theme
      if (!theme) return
      document.documentElement.dataset.theme = theme
      localStorage.setItem('data-theme', theme)
      this.#highlightCurrentTheme()
      this.#close()
    }
  }

  if (!customElements.get('select-theme')) {
    customElements.define('select-theme', SelectTheme)
  }
</script>

<style>
  .theme-dialog {
    width: min(calc(100% - 2rem), 66rem);
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: 1rem auto;
    padding: 0;
    border: 1px solid var(--theme-border-strong);
    border-radius: var(--radius-media);
    color: var(--theme-foreground);
    background: var(--theme-background);
    box-shadow: 0 2rem 7rem var(--theme-shadow);
  }

  .theme-dialog::backdrop {
    background: color-mix(in oklab, var(--theme-background) 55%, transparent);
    backdrop-filter: blur(12px);
  }

  .dialog-frame {
    padding: clamp(1rem, 4vw, 2.25rem);
  }

  .dialog-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--theme-border);
  }

  .dialog-header p {
    margin: 0 0 0.4rem;
    color: var(--theme-text-muted);
  }

  .dialog-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .theme-filter {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-block: 1.25rem;
    padding-inline: 1rem;
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-control);
    background: var(--theme-surface);
  }

  .theme-filter svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    color: var(--theme-text-muted);
  }

  .theme-filter input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    outline: 0;
    color: var(--theme-foreground);
    background: transparent;
  }

  .theme-filter input::placeholder {
    color: var(--theme-text-muted);
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .theme-grid li {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .theme-grid button {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr) 1.2rem;
    align-items: center;
    gap: 0.8rem;
    width: 100%;
    min-height: 4.25rem;
    padding: 0.55rem;
    border: 1px solid var(--theme-border);
    border-radius: 0.85rem;
    color: var(--theme-foreground);
    background: transparent;
    text-align: left;
    transition:
      border-color var(--duration-fast) var(--ease-out-expo),
      background-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }

  .theme-grid button:hover {
    border-color: var(--theme-accent);
    background: var(--theme-accent-soft);
  }

  .theme-grid button:active {
    transform: scale(0.985);
  }

  .theme-grid button[aria-pressed='true'] {
    border-color: var(--theme-accent);
    background: var(--theme-accent-soft);
  }

  .theme-preview {
    position: relative;
    display: flex;
    height: 3rem;
    align-items: flex-end;
    gap: 0.2rem;
    overflow: hidden;
    padding: 0.45rem;
    border: 1px solid color-mix(in oklab, var(--preview-foreground) 25%, transparent);
    border-radius: 0.55rem;
    color: var(--preview-foreground);
    background: var(--preview-background);
  }

  .theme-preview span {
    display: block;
    width: 0.55rem;
    border-radius: 0.2rem 0.2rem 0 0;
    background: currentColor;
  }

  .theme-preview span:first-child {
    height: 45%;
  }

  .theme-preview span:nth-child(2) {
    height: 75%;
    background: var(--preview-accent);
  }

  .theme-preview span:last-child {
    height: 58%;
  }

  .theme-name {
    min-width: 0;
    overflow: hidden;
    font-size: 0.86rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .theme-check {
    width: 1rem;
    height: 1rem;
    color: var(--theme-accent);
    opacity: 0;
  }

  button[aria-pressed='true'] .theme-check {
    opacity: 1;
  }

  .theme-empty {
    margin: 0;
    padding-block: 3rem;
    color: var(--theme-text-muted);
    text-align: center;
  }

  @media (max-width: 47.99rem) {
    .theme-grid {
      grid-template-columns: 1fr;
    }

    .theme-dialog {
      max-height: calc(100dvh - 1rem);
      margin: 0.5rem auto;
    }
  }
</style>
