---
import type { CollectionEntry } from 'astro:content'
import { TagsGroup } from '~/utils'

interface Props {
  posts: CollectionEntry<'posts'>[]
  limit?: number
  variant?: 'default' | 'directory'
}

const { posts, limit, variant = 'default' } = Astro.props
const tags = (await TagsGroup.build(posts)).sortCollationsLargest()
const initialTags = limit ? tags.slice(0, limit) : tags
const remainingTags = limit ? tags.slice(limit) : []
---

<div class:list={['taxonomy-list', `taxonomy-list--${variant}`]}>
  <ul>
    {
      initialTags.map((tag) => (
        <li>
          <a href={tag.url}>
            <span>{tag.title}</span>
            <span>{tag.entries.length}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    remainingTags.length > 0 && (
      <details>
        <summary>Show all {tags.length} topics</summary>
        <ul>
          {remainingTags.map((tag) => (
            <li>
              <a href={tag.url}>
                <span>{tag.title}</span>
                <span>{tag.entries.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</div>

<style>
  .taxonomy-list > ul,
  details ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .taxonomy-list--directory > ul,
  .taxonomy-list--directory details ul {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap-inline: clamp(1rem, 2vw, 2rem);
  }

  li {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--theme-border);
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
    color: var(--theme-foreground);
    text-decoration: none;
  }

  a span:last-child {
    color: var(--theme-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs-fluid);
  }

  a:hover {
    color: var(--theme-accent);
  }

  .taxonomy-list--directory a {
    min-height: 3.25rem;
    padding-block: 0.75rem;
  }

  details {
    margin-top: 1rem;
  }

  summary {
    width: max-content;
    padding: 0.65rem 1rem;
    border: 1px solid var(--theme-border-strong);
    border-radius: var(--radius-control);
    cursor: pointer;
    font-weight: 650;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details ul {
    margin-top: 1rem;
  }

  @media (max-width: 39.99rem) {
    .taxonomy-list > ul,
    details ul {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .taxonomy-list--directory > ul,
    .taxonomy-list--directory details ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
