---
import type { MarkdownHeading } from 'astro'

interface Props {
  heading: MarkdownHeading
}

const {
  heading: { depth, slug, text },
} = Astro.props
---

<li style={{ '--toc-depth': depth - 2 }}>
  <a href={`#${slug}`}>{text}</a>
</li>

<style>
  li {
    margin: 0;
    padding: 0 0 0 calc(var(--toc-depth) * 0.85rem);
    list-style: none;
  }

  a {
    display: block;
    color: inherit;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }

  a:hover,
  a[aria-current] {
    color: var(--theme-accent);
    transform: translateX(0.2rem);
  }

  a[aria-current] {
    font-weight: 700;
  }
</style>
