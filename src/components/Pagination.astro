---
import { Icon } from 'astro-icon/components'

interface Props {
  prevLink?: string
  prevText?: string
  nextLink?: string
  nextText?: string
}

const { prevLink, prevText, nextLink, nextText } = Astro.props
---

<nav class="pagination" aria-label="Pagination">
  {
    prevLink ? (
      <a href={prevLink} rel="prev">
        <Icon name="ph:arrow-left" aria-hidden="true" />
        <span>{prevText || 'Previous'}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    nextLink && (
      <a href={nextLink} rel="next">
        <span>{nextText || 'Next'}</span>
        <Icon name="ph:arrow-right" aria-hidden="true" />
      </a>
    )
  }
</nav>

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--theme-border);
  }

  a {
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: 0.55rem;
    color: var(--theme-foreground);
    font-weight: 700;
    text-decoration-color: var(--theme-accent);
    text-underline-offset: 0.3rem;
  }

  a:last-child {
    justify-self: end;
  }

  a:hover {
    color: var(--theme-accent);
  }

  svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  a:first-child:hover svg {
    transform: translateX(-0.2rem);
  }

  a:last-child:hover svg {
    transform: translateX(0.2rem);
  }

  @media (max-width: 31.99rem) {
    .pagination {
      grid-template-columns: 1fr;
    }

    a:last-child {
      justify-self: start;
    }
  }
</style>
