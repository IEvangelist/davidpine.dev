---
import type { FrontmatterImage } from '~/types'
import { Image } from 'astro:assets'

interface Props {
  avatarImage?: FrontmatterImage
}

const { avatarImage } = Astro.props
---

<aside class="post-addendum" aria-label="About the author" data-reveal>
  {
    avatarImage && (
      <Image
        src={avatarImage.src}
        alt={avatarImage.alt}
        class="author-avatar"
        widths={[180, 280]}
        sizes="7rem"
      />
    )
  }
  <div class="post-addendum-copy prose">
    <slot />
  </div>
</aside>

<style>
  .post-addendum {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: var(--content-medium);
    margin: var(--section-space) auto 0;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-media);
    background: var(--theme-surface);
  }

  .author-avatar {
    width: 7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
  }

  .post-addendum-copy {
    max-width: 42rem;
    margin: 0;
    font-size: var(--text-body-fluid);
  }

  .post-addendum-copy :global(p) {
    margin-block: 0.6rem;
  }

  @media (max-width: 39.99rem) {
    .post-addendum {
      grid-template-columns: 1fr;
    }

    .author-avatar {
      width: 5.5rem;
    }
  }
</style>
