---
import siteConfig from '~/site.config'
import SocialLinks from '~/components/SocialLinks.astro'
import { execFileSync } from 'node:child_process'

const routeLinks = siteConfig.navLinks.filter(
  (link) => !link.external && link.url !== '/',
)
const year = new Date().getFullYear()
const deployedSha = process.env.COMMIT_REF ?? process.env.GITHUB_SHA
const fullCommitSha =
  deployedSha ??
  execFileSync('git', ['rev-parse', 'HEAD'], {
    encoding: 'utf8',
  }).trim()
const shortCommitSha = fullCommitSha.slice(0, 8)
---

<footer class="site-footer">
  <div class="footer-statement">
    <p class="ui-label">David Pine</p>
    <p class="font-display">Building tools. Sharing what I learn.</p>
  </div>

  <div class="footer-grid">
    <nav aria-label="Footer navigation">
      <p class="footer-heading">Explore</p>
      <ul>
        {
          routeLinks.map((link) => (
            <li>
              <a href={link.url}>{link.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="footer-heading">Follow</p>
      {siteConfig.socialLinks && <SocialLinks socialLinks={siteConfig.socialLinks} />}
    </div>
  </div>

  <div class="footer-meta">
    <span>{siteConfig.author} © {year}</span>
    <span class="footer-meta-links">
      <a
        class="commit-link"
        href={`https://github.com/IEvangelist/davidpine.dev/commit/${fullCommitSha}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Commit <code>{shortCommitSha}</code>
      </a>
      <a
        class="uptime-link"
        href="https://stats.uptimerobot.com/ZxMLuZOh33"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i aria-hidden="true"></i>
        Uptime
      </a>
    </span>
    <span class="search-tip">
      <kbd>Ctrl</kbd>/<kbd>⌘</kbd>
      <kbd>K</kbd>
      <span>Search</span>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
    margin-top: var(--section-space);
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    border-top: 1px solid var(--theme-border);
  }

  .footer-statement p:last-child {
    max-width: 13ch;
    margin: 0.65rem 0 0;
    font-size: clamp(2.5rem, 6vw, 6rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 1fr);
    gap: 3rem;
  }

  .footer-heading {
    margin: 0 0 1rem;
    color: var(--theme-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs-fluid);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem 2rem;
    max-width: 30rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav li {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .footer-meta a {
    color: var(--theme-foreground);
    text-decoration-color: var(--theme-border-strong);
    text-underline-offset: 0.25rem;
  }

  .footer-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding-right: 4.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--theme-border);
    color: var(--theme-text-muted);
    font-size: var(--text-sm-fluid);
  }

  .footer-meta-links,
  .uptime-link,
  .commit-link,
  .search-tip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .commit-link code {
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--theme-border);
    border-radius: 0.35rem;
    color: var(--theme-accent);
    background: var(--theme-surface);
    font-family: var(--font-mono);
  }

  .search-tip {
    justify-self: end;
    color: var(--theme-text-muted);
  }

  .footer-meta-links {
    justify-self: center;
  }

  .search-tip kbd {
    min-width: 1.65rem;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--theme-border-strong);
    border-radius: 0.35rem;
    color: var(--theme-foreground);
    background: var(--theme-surface);
    box-shadow: inset 0 -2px 0 var(--theme-border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
  }

  .uptime-link i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--theme-green);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--theme-green) 14%, transparent);
  }

  @media (max-width: 47.99rem) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-meta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding-right: 0;
    }

    .search-tip,
    .footer-meta-links {
      justify-self: auto;
    }
  }
</style>
