---
import '@pagefind/default-ui/css/ui.css'
import { Icon } from 'astro-icon/components'

const { trailingSlashes = false } = Astro.props
---

<site-search data-trailing-slashes={trailingSlashes}>
  <button
    class="icon-control"
    type="button"
    aria-label="Search"
    aria-keyshortcuts="Control+K Meta+K"
    aria-haspopup="dialog"
    data-open-search
    disabled
  >
    <Icon name="ph:magnifying-glass" aria-hidden="true" />
  </button>

  <dialog class="search-dialog" aria-labelledby="search-title" data-search-dialog>
    <div class="dialog-frame">
      <div class="dialog-header">
        <div>
          <p class="ui-label">Find something</p>
          <h2 id="search-title">Search the site</h2>
        </div>
        <button
          class="icon-control"
          type="button"
          aria-label="Close search"
          data-close-search
        >
          <Icon name="ph:x" aria-hidden="true" />
        </button>
      </div>

      {
        import.meta.env.DEV ? (
          <div class="search-message">
            <Icon name="ph:info" aria-hidden="true" />
            <p>
              Search is indexed during the production build. Use the local preview to test
              results.
            </p>
          </div>
        ) : (
          <>
            <p class="search-status" data-search-status>
              Loading the search index...
            </p>
            <div id="pagefind-search" class="search-container" />
          </>
        )
      }
    </div>
  </dialog>
</site-search>

<script>
  class SiteSearch extends HTMLElement {
    #controller = new AbortController()
    #dialog = this.querySelector<HTMLDialogElement>('[data-search-dialog]')
    #dialogFrame = this.querySelector<HTMLElement>('.dialog-frame')
    #openButton = this.querySelector<HTMLButtonElement>('[data-open-search]')
    #closeButton = this.querySelector<HTMLButtonElement>('[data-close-search]')
    #trailingSlashes = this.dataset.trailingSlashes === 'true'

    connectedCallback() {
      const options = { signal: this.#controller.signal }
      this.#openButton?.addEventListener('click', this.#open, options)
      this.#closeButton?.addEventListener('click', this.#close, options)
      this.#dialog?.addEventListener('click', this.#onDialogClick, options)
      this.#dialog?.addEventListener('close', this.#onClose, options)
      window.addEventListener('keydown', this.#onKeydown, options)
      if (this.#openButton) this.#openButton.disabled = false
      this.#initializePagefind()
    }

    disconnectedCallback() {
      this.#controller.abort()
    }

    #formatURL = (path: string) =>
      this.#trailingSlashes ? path : path.replace(/(.)\/(#.*)?$/, '$1$2')

    #initializePagefind = () => {
      if (import.meta.env.DEV) return

      const onIdle =
        window.requestIdleCallback || ((callback) => window.setTimeout(callback, 1))
      onIdle(async () => {
        const { PagefindUI } = await import('@pagefind/default-ui')
        new PagefindUI({
          baseUrl: import.meta.env.BASE_URL,
          bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
          element: '#pagefind-search',
          showImages: false,
          showSubResults: true,
          processResult: (result: {
            url: string
            sub_results: Array<{ url: string }>
          }) => {
            result.url = this.#formatURL(result.url)
            result.sub_results = result.sub_results.map((subResult) => ({
              ...subResult,
              url: this.#formatURL(subResult.url),
            }))
            return result
          },
        })
        this.querySelector('[data-search-status]')?.remove()
      })
    }

    #open = () => {
      this.#dialog?.showModal()
      document.body.classList.add('dialog-open')
      window.setTimeout(
        () => this.#dialog?.querySelector<HTMLInputElement>('input')?.focus(),
        0,
      )
    }

    #close = () => {
      this.#dialog?.close()
    }

    #onClose = () => {
      document.body.classList.remove('dialog-open')
      this.#openButton?.focus()
    }

    #onDialogClick = (event: MouseEvent) => {
      if (
        event.target === this.#dialog ||
        !this.#dialogFrame?.contains(event.target as Node)
      ) {
        this.#close()
      }
    }

    #onKeydown = (event: KeyboardEvent) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault()
        this.#dialog?.open ? this.#close() : this.#open()
      }
    }
  }

  if (!customElements.get('site-search')) {
    customElements.define('site-search', SiteSearch)
  }
</script>

<style>
  .search-dialog {
    width: min(calc(100% - 2rem), 48rem);
    max-width: none;
    max-height: min(48rem, calc(100dvh - 2rem));
    margin: 1rem auto auto;
    padding: 0;
    border: 1px solid var(--theme-border-strong);
    border-radius: var(--radius-media);
    color: var(--theme-foreground);
    background: var(--theme-background);
    box-shadow: 0 2rem 7rem var(--theme-shadow);
  }

  .search-dialog::backdrop {
    background: color-mix(in oklab, var(--theme-background) 55%, transparent);
    backdrop-filter: blur(12px);
  }

  .dialog-frame {
    padding: clamp(1rem, 4vw, 2.25rem);
  }

  .dialog-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--theme-border);
  }

  .dialog-header p {
    margin: 0 0 0.4rem;
    color: var(--theme-text-muted);
  }

  .dialog-header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .search-message {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.5rem;
    padding: 1rem;
    border-radius: 0.8rem;
    color: var(--theme-text-muted);
    background: var(--theme-surface);
  }

  .search-message svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.15rem;
    color: var(--theme-accent);
  }

  .search-message p,
  .search-status {
    margin: 0;
  }

  .search-status {
    padding-block: 1.5rem;
    color: var(--theme-text-muted);
  }
</style>

<style is:global>
  :root {
    --pagefind-ui-font: var(--font-body);
    --pagefind-ui-primary: var(--theme-accent);
    --pagefind-ui-text: var(--theme-foreground);
    --pagefind-ui-background: var(--theme-background);
    --pagefind-ui-border: var(--theme-border-strong);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
  }

  .pagefind-ui {
    padding-top: 1.5rem;
  }

  .pagefind-ui__search-input {
    border-radius: 0.75rem !important;
    color: var(--theme-foreground) !important;
    background: var(--theme-surface) !important;
  }

  .pagefind-ui__search-clear {
    color: var(--theme-foreground) !important;
    background: transparent !important;
  }

  .pagefind-ui__result {
    border-top-color: var(--theme-border) !important;
  }

  .pagefind-ui__result-link {
    color: var(--theme-foreground) !important;
    font-family: var(--font-display);
    font-size: 1.35rem !important;
    letter-spacing: -0.025em;
  }

  .pagefind-ui mark {
    border-radius: 0.2rem;
    color: var(--theme-on-accent) !important;
    background: var(--theme-accent) !important;
  }
</style>
