---
import { Icon } from 'astro-icon/components'
import type { SocialLinks } from '~/types'
import GitHubMark from '~/icons/github.svg'

interface Props {
  socialLinks: SocialLinks
}

const { socialLinks } = Astro.props
const links: Array<{
  label: string
  href: string
  icon: string
  external?: boolean
  rel?: string
  officialGitHub?: boolean
}> = []

if (socialLinks.github) {
  links.push({
    label: 'GitHub',
    href: socialLinks.github,
    icon: 'ph:github-logo',
    external: true,
    officialGitHub: true,
  })
}
if (socialLinks.bluesky) {
  links.push({
    label: 'Bluesky',
    href: socialLinks.bluesky,
    icon: 'ph:butterfly',
    external: true,
  })
}
if (socialLinks.linkedin) {
  links.push({
    label: 'LinkedIn',
    href: socialLinks.linkedin,
    icon: 'ph:linkedin-logo',
    external: true,
  })
}
if (socialLinks.email) {
  links.push({
    label: 'Email',
    href: `mailto:${socialLinks.email}`,
    icon: 'ph:envelope-simple',
  })
}
if (socialLinks.mastodon) {
  links.push({
    label: 'Mastodon',
    href: socialLinks.mastodon,
    icon: 'ph:mastodon-logo',
    external: true,
    rel: 'me noopener noreferrer',
  })
}
if (socialLinks.twitter) {
  links.push({
    label: 'X',
    href: socialLinks.twitter,
    icon: 'ph:x-logo',
    external: true,
  })
}
if (socialLinks.rss) {
  links.push({
    label: 'RSS',
    href: '/rss.xml',
    icon: 'ph:rss-simple',
  })
}
---

<div class="social-links" aria-label="Social links">
  {
    links.map((link) => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.rel ?? (link.external ? 'noopener noreferrer' : undefined)}
        aria-label={link.label}
        title={link.label}
      >
        {link.officialGitHub ? (
          <GitHubMark aria-hidden="true" />
        ) : (
          <Icon name={link.icon} aria-hidden="true" />
        )}
      </a>
    ))
  }
</div>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  a {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--theme-border);
    border-radius: 50%;
    color: var(--theme-foreground);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out-expo),
      background-color var(--duration-fast) var(--ease-out-expo),
      border-color var(--duration-fast) var(--ease-out-expo),
      transform var(--duration-fast) var(--ease-out-expo);
  }

  a:hover {
    border-color: var(--theme-accent);
    color: var(--theme-on-accent);
    background: var(--theme-accent);
    transform: translateY(-2px);
  }

  a:active {
    transform: translateY(0) scale(0.96);
  }

  svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
