---
import TechBadge from './TechBadge.astro'

const techStack = [
  { name: 'C#', icon: 'devicon:csharp' },
  { name: 'Aspire', icon: 'aspire' },
  { name: 'TypeScript', icon: 'devicon:typescript' },
  { name: 'Azure', icon: 'devicon:azure' },
  { name: '.NET', icon: 'dotnet' },
  { name: 'NPM', icon: 'devicon:npm' },
  { name: 'PNPM', icon: 'devicon:pnpm' },
  { name: 'Blazor', icon: 'devicon:blazor' },
  { name: 'JavaScript', icon: 'devicon:javascript' },
  { name: 'Twilio', icon: 'devicon:twilio' },
  { name: 'Node.js', icon: 'devicon:nodejs' },
  { name: 'Tailwind CSS', icon: 'devicon:tailwindcss' },
  { name: 'HTML5', icon: 'devicon:html5' },
  { name: 'CSS3', icon: 'devicon:css3' },
  { name: 'Angular', icon: 'devicon:angular' },
  { name: 'React', icon: 'devicon:react' },
  { name: 'Cosmos DB', icon: 'devicon:cosmosdb' },
  { name: 'Raspberry Pi', icon: 'devicon:raspberrypi' },
  { name: 'Astro', icon: 'devicon:astro' },
  { name: 'GitHub', icon: 'devicon:github' },
  { name: 'GitHub Actions', icon: 'devicon:githubactions' },
  { name: 'GitHub Copilot', icon: 'devicon:githubcopilot' },
  { name: 'Docker', icon: 'devicon:docker' },
  { name: 'Git', icon: 'devicon:git' },
  { name: 'RxJS', icon: 'devicon:rxjs' },
  { name: 'WASM', icon: 'devicon:wasm' },
  { name: 'JSON', icon: 'devicon:json' },
  { name: 'Visual Studio', icon: 'devicon:visualstudio' },
  { name: 'Visual Studio Code', icon: 'devicon:vscode' },
  { name: 'Markdown', icon: 'devicon:markdown' },
].sort((left, right) => left.name.localeCompare(right.name))
---

<div class="tech-marquee" aria-label="Technology stack">
  <div class="tech-track">
    <ul class="tech-list">
      {
        techStack.map((tech) => (
          <li>
            <TechBadge name={tech.name} icon={tech.icon} />
          </li>
        ))
      }
    </ul>
    <ul class="tech-list" aria-hidden="true">
      {
        techStack.map((tech) => (
          <li>
            <TechBadge name={tech.name} icon={tech.icon} />
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .tech-marquee {
    position: relative;
    overflow: hidden;
    padding-block: 0.25rem 1rem;
    mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
  }

  .tech-track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    animation: tech-marquee 52s linear infinite;
    will-change: transform;
  }

  .tech-marquee:hover .tech-track {
    animation-play-state: paused;
  }

  .tech-list {
    display: flex;
    flex: none;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    margin: 0;
    padding: 0;
    list-style: none;
    --badge-color: var(--theme-accent);
  }

  li:nth-child(6n + 2) {
    --badge-color: color-mix(in oklab, var(--theme-blue) 72%, var(--theme-foreground));
  }

  li:nth-child(6n + 3) {
    --badge-color: color-mix(in oklab, var(--theme-magenta) 72%, var(--theme-foreground));
  }

  li:nth-child(6n + 4) {
    --badge-color: color-mix(in oklab, var(--theme-green) 72%, var(--theme-foreground));
  }

  li:nth-child(6n + 5) {
    --badge-color: color-mix(in oklab, var(--theme-yellow) 72%, var(--theme-foreground));
  }

  li:nth-child(6n + 6) {
    --badge-color: color-mix(in oklab, var(--theme-cyan) 72%, var(--theme-foreground));
  }

  @keyframes tech-marquee {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-marquee {
      mask-image: none;
    }

    .tech-track {
      width: 100%;
      animation: none;
      will-change: auto;
    }

    .tech-list {
      width: 100%;
      flex-wrap: wrap;
    }

    .tech-list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
