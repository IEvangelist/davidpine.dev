---
import type { CollectionEntry } from 'astro:content'
import { SeriesGroup } from '~/utils'

interface Props {
  posts: CollectionEntry<'posts'>[]
  limit?: number
}

const { posts, limit } = Astro.props
const series = (await SeriesGroup.build(posts)).sortCollationsMostRecent()
const initialSeries = limit ? series.slice(0, limit) : series
const remainingSeries = limit ? series.slice(limit) : []
---

<div class="series-list">
  <ul>
    {
      initialSeries.map((item) => (
        <li>
          <a href={item.url}>
            <span>{item.title}</span>
            <span>{item.entries.length} posts</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    remainingSeries.length > 0 && (
      <details>
        <summary>Show all {series.length} series</summary>
        <ul>
          {remainingSeries.map((item) => (
            <li>
              <a href={item.url}>
                <span>{item.title}</span>
                <span>{item.entries.length} posts</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</div>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--theme-border);
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    color: var(--theme-foreground);
    text-decoration: none;
  }

  a span:first-child {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  a span:last-child {
    color: var(--theme-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs-fluid);
  }

  a:hover {
    color: var(--theme-accent);
  }

  details {
    margin-top: 1rem;
  }

  summary {
    width: max-content;
    padding: 0.65rem 1rem;
    border: 1px solid var(--theme-border-strong);
    border-radius: var(--radius-control);
    cursor: pointer;
    font-weight: 650;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details ul {
    margin-top: 1rem;
  }
</style>
