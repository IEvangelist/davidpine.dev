---
import PageHeader from '~/components/PageHeader.astro'
import MediaArchive from '~/components/showcase/MediaArchive.astro'
import SpatialGallery from '~/components/showcase/SpatialGallery.astro'
import { mediaEntries } from '~/data/media'
import Layout from '~/layouts/Layout.astro'
import type { SpatialGalleryItem } from '~/types/showcase'

const pageTitle = 'Media'
const pageDescription =
  'Talks, podcasts, publications, and conversations about building software and sharing what we learn.'
const galleryId = 'media-story'

const formatDate = (date?: string) =>
  date
    ? new Intl.DateTimeFormat('en-US', {
        day: 'numeric',
        month: 'short',
        timeZone: 'UTC',
        year: 'numeric',
      }).format(new Date(`${date}T00:00:00Z`))
    : 'From the archive'

const videoEntries = mediaEntries.filter((entry) => entry.kind === 'video')
const mediaGalleryEntries = [...videoEntries].sort((left, right) => {
  if (left.date && right.date) {
    return right.date.localeCompare(left.date)
  }

  if (left.date) {
    return -1
  }

  if (right.date) {
    return 1
  }

  return 0
})

const mediaGalleryItems: SpatialGalleryItem[] = mediaGalleryEntries.map((entry) => {
  return {
    id: entry.id,
    title: entry.title,
    label: entry.description ?? 'Play video',
    meta: `video / ${formatDate(entry.date)}`,
    image: entry.image,
    imageAlt: `${entry.title} artwork`,
    href: entry.url,
    actionLabel: 'Play video',
    action: 'activate',
    tickLabel: entry.date?.slice(0, 4) ?? 'Archive',
    data: {
      'media-kind': 'video',
      'media-url': entry.url,
      'media-title': entry.title,
      ...(entry.youtubeId ? { 'media-youtube-id': entry.youtubeId } : {}),
    },
  }
})
---

<Layout title={pageTitle} description={pageDescription}>
  <PageHeader title={pageTitle} description={pageDescription} />

  <section class="media-story" aria-label="Video reel">
    <div class="media-story__stage reveal-on-scroll">
      <SpatialGallery
        id={galleryId}
        items={mediaGalleryItems}
        variant="media"
        title="Watch the talks"
        description="The complete video collection."
        showHeader={false}
      />
    </div>
  </section>

  <MediaArchive entries={mediaEntries} />
</Layout>

<style>
  :global(main) {
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .media-story {
    display: grid;
    width: min(100%, var(--content-wide));
    margin-inline: auto;
    gap: clamp(1.5rem, 4vw, 2.75rem);
  }

  .media-story__stage {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    border-bottom: 1px solid var(--theme-border);
    background: transparent;
    padding-block: clamp(1.5rem, 3vw, 2.75rem) 0;
  }
</style>
