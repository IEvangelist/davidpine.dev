    tone: '#d40000',
  },
  {
    name: 'Pwned Client',
    tagline: 'Have I Been Pwned, in .NET',
    description:
      'A .NET HTTP client library for the “Have I Been Pwned” (HIBP) API, with a live demo to check emails and passwords against known data breaches.',
    repoUrl: 'https://github.com/IEvangelist/pwned-client',
    pagesUrl: 'https://api.mangomoss-e60b5bb3.centralus.azurecontainerapps.io/',
    lightThumbnail: '/images/projects/pwned-client-light.png',
    darkThumbnail: '/images/projects/pwned-client-dark.png',
    tone: '#f59e0b',
    repoPath: 'IEvangelist/pwned-client',
  },
]

const hexToRgb = (hex) => {
  const clean = hex.replace('#', '')
  const expanded =
    clean.length === 3
      ? clean
          .split('')
          .map((c) => c + c)
          .join('')
      : clean
  return [
    parseInt(expanded.slice(0, 2), 16),
    parseInt(expanded.slice(2, 4), 16),
    parseInt(expanded.slice(4, 6), 16),
  ]
}

// Pick a high-contrast text color for a solid tone background using WCAG 2.x luminance.
const ctaTextOn = (toneHex) => {
  const [r, g, b] = hexToRgb(toneHex).map((channel) => {
    const v = channel / 255
    return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4
  })
  const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
  // Use an off-white foreground for dark tones, otherwise use near-black.
  return lum < 0.18 ? '#f7f7f5' : '#0b0d10'
}
---

<Layout title="Projects" description="Featured projects by David Pine">
  <PageHeader title="Projects" />

  <article class="max-w-full py-7.5 space-y-8">
    <section class="project-intro rounded-2xl border border-accent/20 p-5 md:p-7">
      <p class="m-0 text-lg md:text-xl">
        Built in public and shipped in production. Quick access to each project’s live
        docs and source.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="meta-chip">{projects.length} Featured Repositories</span>
        <span class="meta-chip">Live + source quick actions</span>
      </div>
    </section>

    <div class="project-list flex flex-col gap-10 md:gap-14">
      {
        projects.map((project, idx) => (
          <article
            class:list={['project-row', idx % 2 === 1 && 'project-row--reversed']}
            style={`--card-tone: ${project.tone}; --cta-text: ${ctaTextOn(project.tone)};`}
          >
            <a
              class="image-card group/img"
              href={project.pagesUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${project.name} live site`}
            >
              <img
                src={project.lightThumbnail}
                alt={`${project.name} live site screenshot in light mode`}
                class="thumb-image thumb-image-light"
                loading={idx < 2 ? 'eager' : 'lazy'}
                width="1280"
                height="720"
              />
              <img
                src={project.darkThumbnail}
                alt={`${project.name} live site screenshot in dark mode`}
                class="thumb-image thumb-image-dark"
                loading={idx < 2 ? 'eager' : 'lazy'}
                width="1280"
                height="720"
              />
            </a>

            <div class="info-panel">
              <div class="info-top">
                {project.repoPath && (
                  <span class="repo-path">
                    <Icon class="repo-icon" name="ph:git-fork" aria-hidden="true" />
                    {project.repoPath}
                  </span>
                )}
                <span class="live-status">
                  <span class="live-dot" aria-hidden="true" />
                  Live
                </span>
              </div>

              <p class="info-tagline m-0">{project.tagline}</p>
              <h2 class="info-title m-0">{project.name}</h2>
              <p class="info-description m-0">{project.description}</p>

              <div class="info-actions">
                <a
                  href={project.pagesUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cta cta-primary"
                >
                  <span>Open live site</span>
                  <Icon class="cta-icon" name="ph:arrow-up-right" aria-hidden="true" />
                </a>
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cta cta-secondary"
                >
                  <GitHubMark class="cta-icon" aria-hidden="true" />
                  <span>Source</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </article>
</Layout>

<style>
  .project-intro {
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--theme-accent), transparent 95%),
      color-mix(in srgb, var(--theme-background), var(--theme-accent) 4%)
    );
  }

  .meta-chip {
    display: inline-flex;
    align-items: center;
    font-size: 0.8rem;
    padding: 0.3rem 0.55rem;
    border-radius: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--theme-foreground), transparent 80%);
    background: color-mix(in srgb, var(--theme-accent), transparent 92%);
  }

  /* === Project row: image + info panel === */
  .project-row {
    --tone: var(--card-tone, var(--theme-accent));
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: stretch;
    overflow: hidden;
    border: 2px solid var(--retro-border);
    background: var(--retro-panel);
    box-shadow: var(--retro-shadow);
    transition:
      translate 140ms ease,
      box-shadow 140ms ease;
  }

  .project-row::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    height: 0.55rem;
    background: var(--tone);
  }

  .project-row:hover {
    translate: -3px -3px;
    box-shadow: 9px 9px 0 0 var(--retro-shadow-color);
  }

  @media (min-width: 768px) {
    .project-row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }

    .project-row--reversed {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }

    .project-row--reversed .image-card {
      grid-column: 2;
      grid-row: 1;
    }

    .project-row--reversed .info-panel {
      grid-column: 1;
      grid-row: 1;
      text-align: right;
    }

    .project-row--reversed .info-top {
      flex-direction: row-reverse;
    }

    .project-row--reversed .info-actions {
      justify-content: flex-end;
    }
  }

  /* === Image card === */
  .image-card {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 0 !important;
    border-bottom: 2px solid var(--retro-border) !important;
    border-radius: 0 !important;
    background: color-mix(in srgb, var(--theme-background), var(--tone) 8%) !important;
    box-shadow: none !important;
    text-decoration: none;
    color: inherit;
    isolation: isolate;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .image-card:hover {
    transform: scale(1.015);
    box-shadow: none !important;
    translate: none !important;
  }

  .image-card:focus {
    outline: none;
  }

  .image-card:focus-visible {
    outline: 2px solid var(--tone);
    outline-offset: 3px;
  }

  .thumb-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: left top;
    transition: opacity 0.28s ease;
    opacity: 0;
  }

  .thumb-image-light {
    opacity: 1;
  }

  .thumb-image-dark {
    opacity: 0;
  }

  @media (min-width: 768px) {
    .image-card {
      height: 100%;
      min-height: 22rem;
      aspect-ratio: auto;
      border-right: 2px solid var(--retro-border) !important;
      border-bottom: 0 !important;
    }

    .project-row--reversed .image-card {
      border-right: 0 !important;
      border-left: 2px solid var(--retro-border) !important;
    }
  }

  :root[data-ui-tone='dark'] .thumb-image-light {
    opacity: 0;
  }

  :root[data-ui-tone='dark'] .thumb-image-dark {
    opacity: 1;
  }

  /* === Info panel: minimal content beside the image === */
  .info-panel {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: clamp(1.2rem, 2.4vw, 1.8rem);
  }

  .info-panel:hover {
    translate: none !important;
    box-shadow: none !important;
  }

  .info-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.15rem;
  }

  .repo-path {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--theme-foreground) 88%, transparent);
    letter-spacing: 0.01em;
    word-break: break-all;
    min-width: 0;
  }

  .repo-icon {
    flex-shrink: 0;
  }

  .live-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone), transparent 55%);
    background: color-mix(in srgb, var(--tone), transparent 95%);
    color: var(--theme-foreground);
    flex-shrink: 0;
  }

  .live-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--tone);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone), transparent 50%);
    animation: pulse 1.8s ease-in-out infinite;
  }

  .info-tagline {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: color-mix(in srgb, var(--tone) 7%, var(--theme-foreground));
  }

  .info-title {
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--theme-foreground);
  }

  @media (min-width: 768px) {
    .info-title {
      font-size: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .info-title {
      font-size: 2rem;
    }
  }

  .info-description {
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--theme-foreground) 94%, transparent);
    margin-top: 0.1rem;
  }

  /* === CTAs === */
  .info-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.17rem;
    line-height: 1.1;
    font-weight: 700;
    text-decoration: none;
    padding: 0.6rem 1.05rem;
    border-radius: 0.6rem;
    border: 1px solid transparent;
    color: inherit;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease,
      filter 0.2s ease;
  }

  .cta:focus-visible {
    outline: 2px solid var(--tone);
    outline-offset: 2px;
  }

  .cta-primary {
    background: var(--tone);
    border-color: var(--tone);
    color: var(--cta-text, #0b0d10);
  }

  .cta-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--tone), transparent 65%);
    filter: brightness(1.08);
  }

  .cta-secondary {
    background: transparent;
    border-color: color-mix(in srgb, var(--theme-foreground), transparent 55%);
  }

  .cta-secondary:hover {
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--tone), transparent 92%);
    border-color: color-mix(in srgb, var(--tone), transparent 45%);
    color: color-mix(in srgb, var(--tone), var(--theme-foreground) 50%);
  }

  .cta-icon {
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone), transparent 50%);
    }
    50% {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--tone), transparent 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-card,
    .cta,
    .live-dot {
      transition: none;
      animation: none;
    }

    .image-card:hover {
      transform: none;
    }
  }
</style>
