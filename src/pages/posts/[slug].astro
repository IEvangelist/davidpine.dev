---
import type { GetStaticPaths } from 'astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { LightGallery } from 'astro-lightgallery'
import Layout from '~/layouts/Layout.astro'
import { SeriesGroup, TagsGroup, getSortedPosts, getPostSequenceContext } from '~/utils'
import PostPreview from '~/components/PostPreview.astro'
import DividerText from '~/components/DividerText.astro'
import PostAddendum from '~/components/PostAddendum.astro'
import TableOfContents from '~/components/TableOfContents.astro'
import GiscusLoader from '~/components/GiscusLoader.astro'
import siteConfig from '~/site.config'
import Tags from '~/components/Tags.astro'
import PostInfo from '~/components/PostInfo.astro'
import ThemeImage from '~/components/ThemeImage.astro'
import type { Collation } from '~/types'

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts()
  return posts.map((post) => {
    const { prev, next } = getPostSequenceContext(post, posts)
    return {
      params: { slug: post.id },
      props: { post, prev, next },
    }
  })
}) satisfies GetStaticPaths

const { post, prev, next } = Astro.props
const postData = post.data
const { headings, Content: PostContent, remarkPluginFrontmatter } = await render(post)
const description = remarkPluginFrontmatter.description || postData.description

const addendum = await getCollection('addendum')
let AddendumContent
let addendumAvatarImage
if (addendum.length > 0) {
  const addendumEntry = addendum[0]
  const { Content } = await render(addendumEntry)
  AddendumContent = Content
  addendumAvatarImage = addendumEntry.data.avatarImage
}

const sortedPosts = await getSortedPosts()
let series: Collation<'posts'> | undefined
let nextPostInSeries: CollectionEntry<'posts'> | undefined
if (postData.series) {
  const seriesGroup = await SeriesGroup.build(sortedPosts)
  series = seriesGroup.match(postData.series)
  if (!series) {
    throw new Error(`Series "${postData.series}" not found`)
  }
  nextPostInSeries = getPostSequenceContext(post, series.entries).next
}

let tags: Collation<'posts'>[] | undefined
if (postData.tags?.length) {
  const tagsGroup = await TagsGroup.build(sortedPosts)
  tags = tagsGroup.matchMany(postData.tags)
}

const relatedPosts = series
  ? series.entries.filter((entry) => entry.id !== post.id).slice(0, 3)
  : [prev, next].filter((entry): entry is CollectionEntry<'posts'> => Boolean(entry))
---

<Layout
  title={postData.title}
  description={postData.description}
  author={postData.author}
  tags={postData.tags}
>
  <article class="article-page" data-pagefind-body>
    <LightGallery
      class="article-gallery"
      options={{
        selector: '.post-gallery-item',
        thumbnail: true,
      }}
      addPlugins={['zoom']}
    >
      <header class="article-header" data-reveal>
        <PostInfo post={post} />
        <h1 id={post.id}>{postData.title}</h1>
        {description && <p>{description}</p>}
        {tags && <Tags tags={tags} />}
      </header>

      {
        postData.coverImage && (
          <ThemeImage
            priority
            zoomable
            src={postData.coverImage.src}
            lightSrc={postData.coverImage.lightSrc}
            alt={postData.coverImage.alt}
            class="article-cover"
            imageClass="article-cover-image"
          />
        )
      }

      <div class="article-layout">
        <div class="article-content prose">
          <PostContent />
        </div>
        {postData.toc && headings.length > 0 && <TableOfContents headings={headings} />}
      </div>
    </LightGallery>
  </article>

  {
    nextPostInSeries && (
      <a class="series-next" href={`/posts/${nextPostInSeries.id}`}>
        <span>Continue this series</span>
        <strong>{nextPostInSeries.data.title}</strong>
        <Icon name="ph:arrow-right" aria-hidden="true" />
      </a>
    )
  }

  {
    AddendumContent && (
      <PostAddendum avatarImage={addendumAvatarImage}>
        <AddendumContent />
      </PostAddendum>
    )
  }

  {
    relatedPosts.length > 0 && (
      <section class="article-followup">
        <DividerText text={series ? `More from ${series.title}` : 'Keep reading'} />
        <div
          class:list={[
            'related-grid',
            `related-grid--${Math.min(relatedPosts.length, 3)}`,
          ]}
        >
          {relatedPosts.map((relatedPost) => (
            <PostPreview post={relatedPost} variant="compact" />
          ))}
        </div>
        {series && (
          <a class="series-index-link" href={series.url}>
            View the complete series
            <Icon name="ph:arrow-right" aria-hidden="true" />
          </a>
        )}
      </section>
    )
  }

  {
    siteConfig.giscus && (
      <section class="comments-section">
        <DividerText text="Comments" />
        <p class="comments-intro">
          Questions, corrections, and additions are welcome. Sign in with GitHub to join
          the discussion.
        </p>
        <div class="comments-panel">
          <GiscusLoader />
        </div>
      </section>
    )
  }
</Layout>

<style>
  .article-header {
    display: grid;
    gap: 1.25rem;
    max-width: 68rem;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .article-header h1 {
    max-width: 16ch;
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h1-fluid);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .article-header > p {
    max-width: 58ch;
    margin: 0.5rem 0 0;
    color: var(--theme-text-muted);
    font-size: var(--text-lead-fluid);
    line-height: 1.48;
    text-wrap: pretty;
  }

  .article-cover {
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(0.5rem, 1.5vw, 1rem);
    border-radius: var(--radius-media);
    background: var(--theme-surface);
  }

  .article-cover :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 52rem;
    border: 0;
    border-radius: inherit;
    object-fit: contain;
  }

  :global(.article-gallery) {
    display: block;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 50rem) minmax(9rem, 11.5rem);
    justify-content: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-top: clamp(3rem, 8vw, 7rem);
  }

  .article-content {
    min-width: 0;
    max-width: 50rem;
    margin: 0;
  }

  .series-next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 1rem;
    max-width: var(--content-reading);
    margin: var(--section-space) auto 0;
    padding: 1.25rem 0;
    border-block: 1px solid var(--theme-border);
    color: var(--theme-foreground);
    text-decoration: none;
  }

  .series-next span {
    color: var(--theme-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs-fluid);
    text-transform: uppercase;
  }

  .series-next strong {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .series-next svg {
    grid-row: 1 / 3;
    grid-column: 2;
    width: 1.3rem;
    height: 1.3rem;
    align-self: center;
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .series-next:hover {
    color: var(--theme-accent);
  }

  .series-next:hover svg {
    transform: translateX(0.25rem);
  }

  .article-followup,
  .comments-section {
    width: 100%;
    max-width: var(--content-medium);
    margin: var(--section-space) auto 0;
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--theme-border);
  }

  .related-grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .related-grid--1 {
    grid-template-columns: minmax(0, 40rem);
  }

  .related-grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .related-grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .comments-intro {
    max-width: 58ch;
    margin: -0.5rem 0 2rem;
    color: var(--theme-text-muted);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .comments-panel {
    width: 100%;
    min-height: 12rem;
    padding: clamp(0.75rem, 2.5vw, 2rem);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-panel);
    background: var(--theme-surface);
  }

  .comments-panel :global(.giscus) {
    width: 100%;
  }

  .series-index-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--theme-foreground);
    font-weight: 700;
    text-underline-offset: 0.25rem;
  }

  .series-index-link:hover {
    color: var(--theme-accent);
  }

  .series-index-link svg {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 63.99rem) {
    .article-layout {
      grid-template-columns: 1fr;
    }

    .article-content {
      max-width: var(--content-reading);
      margin-inline: auto;
    }

    .article-layout :global(.toc) {
      grid-row: 1;
      max-width: var(--content-reading);
      margin-inline: auto;
    }
  }

  @media (max-width: 47.99rem) {
    .related-grid--2,
    .related-grid--3 {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  a.heading-anchor {
    text-decoration-thickness: 0.06em;
  }
</style>
