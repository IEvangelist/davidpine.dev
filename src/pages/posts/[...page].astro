---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import { getSortedPosts } from '~/utils'
import Pagination from '~/components/Pagination.astro'
import siteConfig from '~/site.config'
import PostPreview from '~/components/PostPreview.astro'
import PageHeader from '~/components/PageHeader.astro'

export const getStaticPaths = (async ({ paginate }) => {
  const sortedPosts = await getSortedPosts()
  return paginate(sortedPosts.reverse(), { pageSize: siteConfig.pageSize })
}) satisfies GetStaticPaths

const { page } = Astro.props
const pageTitle = 'Blog' + (page.currentPage > 1 ? ` - Page ${page.currentPage}` : '')
const [firstPost, ...remainingPosts] = page.data
const previewVariants = ['default', 'reverse'] as const
---

<Layout
  title={pageTitle}
  description="Writing about Aspire, .NET, developer tools, open source, and software engineering."
>
  <PageHeader
    title="Blog"
    description="Writing about Aspire, .NET, developer tools, open source, and software engineering."
  />

  <section class="post-index" aria-label="Articles">
    {
      firstPost && (
        <PostPreview
          post={firstPost}
          variant={page.currentPage === 1 ? 'featured' : 'default'}
        />
      )
    }
    {
      remainingPosts.map((post, index) => (
        <PostPreview
          post={post}
          variant={previewVariants[index % previewVariants.length]}
        />
      ))
    }
  </section>

  <Pagination
    prevLink={page.url.prev ? page.url.prev : undefined}
    prevText="Newer posts"
    nextLink={page.url.next ? page.url.next : undefined}
    nextText="Older posts"
  />
</Layout>

<style>
  .post-index {
    padding-top: clamp(3rem, 8vw, 7rem);
  }

  .post-index :global(.post-preview--featured) {
    margin-bottom: clamp(4rem, 9vw, 8rem);
  }
</style>
