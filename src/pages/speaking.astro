---
import { Icon } from 'astro-icon/components'

import PageHeader from '~/components/PageHeader.astro'
import SpeakingArchive from '~/components/showcase/SpeakingArchive.astro'
import SpeakingGlobe from '~/components/showcase/SpeakingGlobe.astro'
import SpatialGallery from '~/components/showcase/SpatialGallery.astro'
import { speakingEvents, speakingJourney, type SpeakingStoryStop } from '~/data/speaking'
import Layout from '~/layouts/Layout.astro'
import type { SpatialGalleryItem } from '~/types/showcase'

const pageTitle = 'Speaking'
const pageDescription =
  'A chronological journey through developer conferences, community events, and conversations around the world.'
const galleryId = 'speaking-journey'

const getLocationLabel = (stop: SpeakingStoryStop) => {
  if (stop.location) {
    return [stop.location.city, stop.location.region, stop.location.country]
      .filter(Boolean)
      .join(', ')
  }

  return 'Remote'
}

const galleryItems: SpatialGalleryItem[] = speakingJourney.map((stop) => ({
  id: stop.id,
  title: stop.event,
  label: stop.talk,
  meta: `${stop.status === 'upcoming' ? 'Upcoming / ' : ''}${stop.displayDate} / ${getLocationLabel(stop)}`,
  href: stop.talkUrl ?? stop.eventUrl,
  actionLabel: stop.talkUrl ? 'Open talk' : 'Open event',
  action: stop.talkUrl || stop.eventUrl ? 'link' : undefined,
  tickLabel: stop.date.slice(0, 4),
  data: {
    'speaking-date': stop.displayDate,
    'speaking-date-time': stop.date,
    'speaking-status': stop.status,
    'speaking-location': getLocationLabel(stop),
    'speaking-mode':
      stop.format === 'online'
        ? 'online'
        : stop.location
          ? (stop.travelFromPrevious ?? 'origin')
          : 'online',
  },
}))
---

<Layout title={pageTitle} description={pageDescription}>
  <PageHeader title={pageTitle} description={pageDescription} />

  <section class="speaking-journey" aria-label="Speaking timeline">
    <div class="speaking-stage reveal-on-scroll">
      <SpeakingGlobe galleryId={galleryId} stops={speakingJourney} />
      <div class="speaking-stage__gallery">
        <SpatialGallery
          id={galleryId}
          items={galleryItems}
          variant="speaking"
          title="Speaking through time"
          showHeader={false}
        />
      </div>
    </div>
  </section>

  <section
    class="speaking-invite reveal-on-scroll"
    aria-labelledby="speaking-invite-title"
  >
    <div class="speaking-invite__icon" aria-hidden="true">
      <Icon name="ph:microphone-stage" />
    </div>
    <div>
      <p class="speaking-invite__eyebrow">Bring the conversation to your audience</p>
      <h2 id="speaking-invite-title">Let&apos;s make the next stop yours.</h2>
      <p>
        Planning a conference, user group, podcast, or internal event? Tell me about the
        audience and the idea you want them to carry home.
      </p>
    </div>
    <a class="speaking-invite__action" href="mailto:david.pine@microsoft.com">
      Start a conversation
      <Icon name="ph:arrow-up-right" aria-hidden="true" />
    </a>
  </section>

  <SpeakingArchive events={speakingEvents} />
</Layout>

<style>
  :global(main) {
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .speaking-invite__eyebrow {
    margin: 0;
    color: var(--theme-accent);
    font-size: var(--text-xs-fluid);
    font-weight: 720;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .speaking-invite h2 {
    margin: 0;
    color: var(--theme-heading2);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .speaking-journey {
    display: grid;
    width: min(100%, var(--content-wide));
    margin-inline: auto;
  }

  .speaking-stage {
    position: relative;
    display: grid;
    width: 100vw;
    min-height: clamp(46rem, 80vw, 58rem);
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    border-bottom: 1px solid var(--theme-border);
    background:
      radial-gradient(
        circle at 50% 36%,
        color-mix(in oklab, var(--theme-accent) 16%, transparent),
        transparent 42%
      ),
      var(--theme-surface-raised);
    isolation: isolate;
  }

  .speaking-stage > :global(speaking-globe),
  .speaking-stage__gallery {
    grid-area: 1 / 1;
  }

  .speaking-stage > :global(speaking-globe) {
    --globe-opacity: 0.92;

    position: relative;
    z-index: 0;
    min-height: 100%;
  }

  .speaking-stage__gallery {
    z-index: 1;
    align-self: end;
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem) 0;
  }

  .speaking-invite {
    display: grid;
    width: min(100%, var(--content-medium));
    margin-inline: auto;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-panel);
    background: var(--theme-surface);
    box-shadow: 0 12px 36px var(--theme-shadow);
    padding: clamp(1.4rem, 4vw, 2.75rem);
  }

  .speaking-invite__icon {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--theme-accent);
    color: var(--theme-on-accent);
  }

  .speaking-invite__icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .speaking-invite > div:not(.speaking-invite__icon) {
    display: grid;
    gap: 0.55rem;
  }

  .speaking-invite h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  .speaking-invite p:not(.speaking-invite__eyebrow) {
    max-width: 58ch;
    margin: 0;
    color: var(--theme-text-light);
    line-height: 1.65;
  }

  .speaking-invite__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.8rem;
    border-radius: var(--radius-control);
    background: var(--theme-accent);
    color: var(--theme-on-accent);
    font-size: 0.86rem;
    font-weight: 720;
    padding: 0.78rem 1.05rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 180ms var(--ease-out-expo),
      box-shadow 180ms ease;
  }

  .speaking-invite__action:hover {
    box-shadow: 0 10px 30px color-mix(in oklab, var(--theme-accent) 24%, transparent);
    transform: translateY(-2px);
  }

  .speaking-invite__action :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (min-width: 800px) {
    .speaking-invite {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 799px) {
    .speaking-stage {
      min-height: 43rem;
    }

    .speaking-stage > :global(speaking-globe) {
      --globe-opacity: 0.76;
    }

    .speaking-invite__action {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .speaking-invite__action {
      transition: none;
    }

    .speaking-invite__action:hover {
      transform: none;
    }
  }
</style>
